# Contact overrides. The confirmed business email addresses are used when left blank.
# WhatsApp number in international format, digits only (e.g. country code + number).
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Optional comma-separated email recipients for contact enquiries.
NEXT_PUBLIC_CONTACT_EMAIL=Info.strategyexperts@gmail.com,Info@strategyexperts.in
# Public site origin, used for metadata / social sharing. Include https://.
NEXT_PUBLIC_SITE_URL=https://www.strategyexperts.in
# Set to "true" ONLY after the transcribed impact figures have been verified and approved.
NEXT_PUBLIC_SHOW_METRICS=false
